# veilox settings. Copy to .env, or run `veilox setup` to create .env with a new key.
# Keep .env private: never commit it.

# Your provider key: fill in the one you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The key your apps use to call veilox. `veilox setup` creates a random one.
VEILOX_KEY=

# Optional: the app's name in reports (default: default)
VEILOX_APP=

# Optional: address and database file
# VEILOX_LISTEN=:8080
# VEILOX_DB=./data/veilox.db
